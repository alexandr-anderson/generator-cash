# Timeweb MySQL (user name = database name)
DATABASE_URL="mysql://<DB_USER>:<DB_PASSWORD>@localhost:3306/<DB_NAME>"

# Cookie sessions
SESSION_SECRET="generate-a-long-random-string"

# Admin cabinet: comma-separated emails that get role=admin on login
ADMIN_EMAILS="you@postvmeste.ru"

# Public site URL (links in emails)
APP_URL="https://postvmeste.ru"

# Resend HTTPS API (do not use SMTP on Timeweb — outbound 587 is often blocked)
MAIL_FROM="postvmeste <service@postvmeste.ru>"
RESEND_API_KEY="re_..."

# OpenAI-compatible gateway (text for «Помочь с текстом» and «Создать»)
OPENAI_BASE_URL="https://codex-free.com/v1"
OPENAI_API_KEY="cpa_..."
OPENAI_MODEL="gpt-5.5"

# Separate image gateway (posts). Do not reuse the chat key.
OPENAI_IMAGE_BASE_URL="https://codex.sale/v1/images/generations"
OPENAI_IMAGE_API_KEY="..."
OPENAI_IMAGE_MODEL="gpt-image-2"

# Telegram alerts. Create a bot via @BotFather, then send it /start from the target chat.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_CHAT="<telegram-username-или-канал>"
