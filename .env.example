# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postvmeste"

# Cookie sessions
SESSION_SECRET="generate-a-long-random-string"

# Public site URL (links in emails)
APP_URL="https://postvmeste.ru"

# Transactional email (SMTP). If SMTP_HOST is empty, links are printed to server logs.
MAIL_FROM="postvmeste <noreply@postvmeste.ru>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
