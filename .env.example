# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postvmeste"

# Cookie sessions
SESSION_SECRET="generate-a-long-random-string"

# Public site URL (links in emails)
APP_URL="https://postvmeste.ru"

# Resend SMTP (https://resend.com/docs/send-with-smtp)
# SMTP_USER is the word "resend", not an email. SMTP_PASS is the API key (re_...).
MAIL_FROM="postvmeste <service@postvmeste.ru>"
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASS=""
