# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postvmeste"

# Cookie sessions
SESSION_SECRET="generate-a-long-random-string"

# Public site URL (links in emails)
APP_URL="https://postvmeste.ru"

# Resend HTTPS API (do not use SMTP on Timeweb — outbound 587 is often blocked)
MAIL_FROM="postvmeste <service@postvmeste.ru>"
RESEND_API_KEY="re_..."
