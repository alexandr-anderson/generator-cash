# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/release

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local uploads
/uploads

# database dumps from scripts/backup-db.js
/backups

# uptime checker local state
.uptime-state.json

# исходники фонов от модели: ~1,5 МБ штука, в гит идёт только сжатый webp
# из public/backgrounds (см. scripts/backgrounds.mjs)
/.backgrounds-raw

# временные макеты ДНК, живут только на время выбора направления
/public/_refs


# generated user brand DNA (not the product chrome)
.brand/

# local mysql migrate temp
.mysql-migrate-*.cnf

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
