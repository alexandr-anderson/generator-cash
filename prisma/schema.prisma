generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  free
  starter
  pro
  business
}

enum CreativeFormat {
  carousel
  post
  reel
}

enum FileKind {
  logo
  reference
  photo
  export
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  emailVerifiedAt    DateTime?
  niche              String
  audience           String?
  tone               String?
  colors             Json?
  logoFileId         String?
  profileCompleted   Boolean   @default(false)
  profilePopupShown  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions           Session[]
  emailTokens        EmailToken[]
  resetTokens        PasswordReset[]
  usage              UsageState?
  rubrics            Rubric[]
  works              Work[]
  files              FileAsset[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model UsageState {
  id                    String            @id @default(cuid())
  userId                String            @unique
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                  SubscriptionTier  @default(free)
  generationsPerWeek    Int               @default(1)
  priceRub              Int               @default(0)
  generationsUsed       Int               @default(0)
  weekStartedAt         DateTime          @default(now())
  initialFreeRemaining  Int               @default(5)
  updatedAt             DateTime          @updatedAt
}

model Rubric {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  colors         Json?
  inspirationUrl String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  templates      RubricTemplate[]
  works          Work[]
  files          FileAsset[]

  @@index([userId])
}

model RubricTemplate {
  id         String         @id @default(cuid())
  rubricId   String
  rubric     Rubric         @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  format     CreativeFormat
  layout     String
  scenario   String
  decorStyle String
  font       String
  colors     Json
  slideCount Int
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([rubricId, format])
}

model Work {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rubricId    String
  rubric      Rubric         @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  format      CreativeFormat
  topic       String        @db.Text
  slides      Json
  caption     String        @db.Text
  hashtags    Json
  reelScript  String?       @db.Text
  layout      String
  background  String
  accent      String
  foreground  String
  eyebrow     String
  brandLabel  String
  createdAt   DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([rubricId])
}

model FileAsset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rubricId  String?
  rubric    Rubric?   @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  kind      FileKind
  objectKey String       @db.VarChar(512)
  mimeType  String
  byteSize  Int
  createdAt DateTime  @default(now())

  @@index([userId, kind])
  @@index([rubricId])
}
