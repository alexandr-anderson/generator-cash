# postvmeste-node-proxy
# Timeweb document root: postvmeste/public_html
# Always proxy to the Next.js standalone process (including /).
# public_html is a directory, so !-d would skip the homepage rewrite.

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(.*)$ http://127.0.0.1:__APP_PORT__/$1 [P,L]
</IfModule>
