# Copy to scripts/deploy.env on your computer or on the server.
# scripts/deploy.env is ignored by git.

DEPLOY_PATH=/home/c/<SSH_USER>/postvmeste
PUBLIC_HTML=/home/c/<SSH_USER>/postvmeste/public_html
GIT_BRANCH=main
GIT_REMOTE=origin
GIT_REPO_URL=https://github.com/alexandr-anderson/generator-cash.git

APP_NAME=postvmeste
# filo already uses port 3000 on this Timeweb account.
APP_PORT=3001
NODE_ENV=production

# Timeweb shared hosting often crashes native postinstall scripts.
NPM_CI_ARGS=--ignore-scripts

# Optional: uncomment if node/npm are not in default PATH on Timeweb.
# NODE_BIN=/home/c/<SSH_USER>/.nvm/versions/node/v22.14.0/bin/node
# NPM_BIN=/home/c/<SSH_USER>/.nvm/versions/node/v22.14.0/bin/npm
# PM2_BIN=/home/c/<SSH_USER>/postvmeste/node_modules/.bin/pm2

# Local-only settings for npm run deploy
SSH_HOST=<хост-хостинга>
SSH_USER=<ваш-логин-на-хостинге>
SSH_PORT=22

# Optional SSH key path for local deploy script.
# SSH_IDENTITY_FILE=~/.ssh/id_ed25519

# Optional mysqldump/mariadb-dump path for scripts/backup-db.js
# MYSQLDUMP_BIN=mysqldump
# BACKUP_KEEP=7

# GitHub Actions secrets (Settings -> Secrets and variables -> Actions):
# SSH_PRIVATE_KEY  - private key with access to Timeweb SSH
# SSH_HOST           - хост SSH на хостинге
# SSH_USER           - логин SSH на хостинге
# SSH_PORT           - optional, default 22
# TELEGRAM_BOT_TOKEN - bot from @BotFather for alerts to @mr_anderson_say
# TELEGRAM_CHAT_ID   - optional numeric chat id after /start
